# Pokemon TCG API Key
# Get your key from https://pokemontcg.io/
VITE_POKEMON_TCG_API_KEY=your_api_key_here

# Backend API URL (production: your Railway/Render URL; Docker: leave empty — nginx proxies /api)
VITE_API_URL=http://localhost:3001
# Legacy alias still read by the app if VITE_API_URL is unset
# VITE_BACKEND_URL=https://your-backend.up.railway.app

# Card Scanner Backend URL
VITE_CARD_SCANNER_API_URL=http://localhost:5001

# Sentry Configuration (Optional)
# VITE_SENTRY_DSN=your_sentry_dsn_here
# VITE_SENTRY_ENVIRONMENT=development

# API Base URLs
VITE_API_BASE_URL=https://api.pokemontcg.io/v2
