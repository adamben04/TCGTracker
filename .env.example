# Backend API URL — Vite dev server proxies all /api/* routes to this target.
# Use Railway in dev to avoid running a local 1.5GB SQLite backend:
# VITE_API_URL=https://your-backend.up.railway.app
# Use localhost only when actively developing backend code:
# VITE_API_URL=http://localhost:3001
# VITE_BACKEND_URL=https://your-backend.up.railway.app

# Card Scanner Backend URL (optional — defaults to http://localhost:5001)
# VITE_CARD_SCANNER_API_URL=http://localhost:5001

# Sentry Configuration (Optional)
# VITE_SENTRY_DSN=your_sentry_dsn_here
# VITE_SENTRY_ENVIRONMENT=production

# Feature Flags
# VITE_ENABLE_AUTH=true
# VITE_ENABLE_ANALYTICS=false

# Google Analytics (Optional)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# App Metadata
# VITE_APP_NAME=TCGTracker
# VITE_APP_VERSION=1.0.0
