# Pokemon TCG API Key
# Get your key from https://pokemontcg.io/
VITE_POKEMON_TCG_API_KEY=your_api_key_here

# Card Scanner Backend URL
# Default: http://localhost:5001 (changed from 5000 due to AirPlay on macOS)
VITE_CARD_SCANNER_API_URL=http://localhost:5001

# Sentry Configuration (Optional)
# VITE_SENTRY_DSN=your_sentry_dsn_here
# VITE_SENTRY_ENVIRONMENT=development

# API Base URLs
VITE_API_BASE_URL=https://api.pokemontcg.io/v2
