NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./tcg-prices.db

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_char_hex_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Comma-separated exact origins. Production must include:
# https://tcgtracker-9oc.pages.dev
CORS_ORIGIN=http://localhost:5173
CARD_SCANNER_URL=http://localhost:5001
CARD_SCANNER_PROXY_SECRET=replace-with-the-same-random-32-character-scanner-secret

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
LOG_FILE=./backend.log

# Optional API keys — never commit real values
POKEMON_TCG_API_KEY=
TCGCSV_API_KEY=
APIFY_API_TOKEN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@tcgtracker.com

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

ADMIN_USERNAME=admin
# Optional immutable role bootstrap. Register this account, set the value, then restart.
ADMIN_BOOTSTRAP_EMAIL=

CLOUD_SYNC_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=tcgtracker-data
